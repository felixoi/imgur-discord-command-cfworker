# Copy to .env and fill in. Never commit .env.
# Read by `npm run dev`, `npm run register` and `cf deploy --secrets-file .env`.

# Discord developer portal
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=

# Imgur API
IMGUR_CLIENT_ID=
IMGUR_CLIENT_SECRET=
IMGUR_REFRESH_TOKEN=

# Optional: `npm run register` registers to this server instantly instead of globally
DISCORD_TEST_GUILD_ID=
