{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Lets Node run src/register.ts directly via type stripping
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true
  },
  "include": ["src", "cloudflare.config.ts", "vite.config.ts", ".cloudflare/types"]
}
